{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Shard": {
    "SpoolDirectory": "/tmp/mel-spool",
    "OutputDirectory": "output",
    "SamplesPerShard": 5000,
    "MaxMelBytes": 2000000000
  },
  "Mounts": {
    "BasePath": "/data",
    "Output": {
      "Name": "grassmann-mel-cache",
      "RepoId": "tisaconundrum/grassmann-mel-cache",
      "ReadOnly": false
    },
    "Inputs": [
      {
        "Name": "librispeech",
        "RepoId": "openslr/librispeech_asr"
      },
      {
        "Name": "voxpopuli",
        "RepoId": "facebook/voxpopuli"
      },
      {
        "Name": "peoples-speech",
        "RepoId": "MLCommons/peoples_speech"
      }
    ]
  }
}
