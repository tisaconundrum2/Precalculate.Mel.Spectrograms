{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Shard": {
    "SpoolDirectory": "/tmp/mel-spool",
    "OutputDirectory": "output",
    "HubRepo": "tisaconundrum/grassmann-mel-cache",
    "HubPrefix": "shards",
    "SamplesPerShard": 5000,
    "MaxMelBytes": 2000000000
  },
  "Mounts": {
    "BasePath": "/data",
    "Output": {
      "Name": "grassmann-mel-cache",
      "RepoId": "tisaconundrum/grassmann-mel-cache",
      "ReadOnly": false
    },
    "Inputs": [
      {
        "Name": "librispeech",
        "RepoId": "openslr/librispeech_asr"
      },
      {
        "Name": "voxpopuli",
        "RepoId": "facebook/voxpopuli"
      },
      {
        "Name": "peoples-speech",
        "RepoId": "MLCommons/peoples_speech"
      }
    ]
  },
  "Recipe": {
    "Name": "1750h",
    "Sources": [
      {
        "Name": "openslr/librispeech_asr",
        "Split": "train.clean.100",
        "Config": "all"
      },
      {
        "Name": "openslr/librispeech_asr",
        "Split": "train.clean.360",
        "Config": "all"
      },
      {
        "Name": "openslr/librispeech_asr",
        "Split": "train.other.500",
        "Config": "all"
      },
      {
        "Name": "facebook/voxpopuli",
        "Split": "train",
        "Config": "en",
        "TextColumn": "raw_text"
      },
      {
        "Name": "MLCommons/peoples_speech",
        "Split": "train",
        "Config": "clean",
        "MaxSamples": 30000
      }
    ]
  }
}
